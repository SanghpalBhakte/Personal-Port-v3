# ==========================================
# Sanghpal Bhakte Portfolio - Environment Variables
# ==========================================

# Base URL (used for SEO metadata, sitemaps, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://sanghpal.dev

# (Optional) Upstash Redis for distributed stats persistence & rate-limiting on Vercel Edge
# If left unset, the application gracefully falls back to local in-memory store.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# (Optional) Resend API Key for dispatching contact form emails directly to your inbox
# If left unset, contact submissions are logged to the console/persistent store gracefully.
RESEND_API_KEY=re_123456789
CONTACT_NOTIFICATION_EMAIL=sanghapal2006@gmail.com
